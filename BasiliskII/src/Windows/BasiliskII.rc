BasiliskII ICON PRELOAD "BasiliskII.ico"

#include <winver.h>

1 VERSIONINFO
FILEVERSION 1,1,0,0
PRODUCTVERSION 1,1,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS__WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Christian Bauer et al."
            VALUE "FileDescription", "Basilisk II 68k Macintosh Emulator"
            VALUE "FileVersion", "1.1.0.0"
            VALUE "InternalName", "BasiliskII"
            VALUE "LegalCopyright", "Copyright (C) 1997-2026 Christian Bauer et al."
            VALUE "OriginalFilename", "BasiliskII.exe"
            VALUE "ProductName", "Basilisk II"
            VALUE "ProductVersion", "1.1 (" __DATE__ ")"
            VALUE "Comments", "Built on " __DATE__
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
